# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Rust / Tauri
target/
**/src-tauri/target/
**/src-tauri/gen/
# Shared Rust library crates — built as path-dependencies of the apps (their
