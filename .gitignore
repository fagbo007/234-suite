packages/ai-backend/Cargo.lock
packages/file-io/Cargo.lock

# Suite installer output (also covered by dist/ above; explicit for clarity)
installer/dist/

# Generated docs site (also covered by dist/ above; explicit for clarity)
packages/docs-site/dist/

# Test / coverage artifacts
coverage/
playwright-report/
test-results/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
